@model IEnumerable<PAW.Models.DTO.NotificationDTO>

@{
    ViewData["Title"] = "Notification Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Notifications</h2>

        <button type="button"
                class="btn btn-primary"
                onclick="loadNotificationCreate()">

            <i class="bi bi-plus-circle"></i>
            Add Notification

        </button>

    </div>

    <div id="notificationDetails"></div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>ID</th>
                            <th>User ID</th>
                            <th>Message</th>
                            <th>Is Read</th>
                            <th>Created At</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var notification in Model)
                            {
                                <tr>

                                    <td>@notification.Id</td>

                                    <td>@notification.UserId</td>

                                    <td>@notification.Message</td>

                                    <td>@notification.IsRead</td>

                                    <td>
                                        @notification.CreatedAt?.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="loadNotificationEdit(@notification.Id)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="loadNotificationDetails(@notification.Id)">
                                                Details
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteNotification(@notification.Id)">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="6"
                                    class="text-center">

                                    No notifications found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        async function loadNotificationDetails(id) {

            const response =
                await fetch('/Notification/Details?id=' + id);

            const html =
                await response.text();

            document.getElementById('notificationDetails')
                .innerHTML = html;
        }


        async function loadNotificationEdit(id) {

            const response =
                await fetch('/Notification/Edit?id=' + id);

            const html =
                await response.text();

            document.getElementById('notificationDetails')
                .innerHTML = html;
        }


        async function saveNotificationEdit() {

            const form =
                document.getElementById('editNotificationForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/Notification/Edit', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function loadNotificationCreate() {

            const response =
                await fetch('/Notification/Create');

            const html =
                await response.text();

            document.getElementById('notificationDetails')
                .innerHTML = html;
        }


        async function saveNotificationCreate() {

            const form =
                document.getElementById('createNotificationForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/Notification/Create', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function deleteNotification(id) {

            const confirmed =
                confirm('Are you sure you want to delete this notification?');

            if (!confirmed) {
                return;
            }

            const response =
                await fetch('/Notification/Delete?id=' + id, {
                    method: 'POST'
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }

    </script>
}
