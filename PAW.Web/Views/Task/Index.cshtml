@model IEnumerable<PAW.Models.DTO.TaskDTO>

@{
    ViewData["Title"] = "Task Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Tasks</h2>

        <a asp-action="Create" class="btn btn-primary">
            Add Task
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th>Due Date</th>
                            <th>Created At</th>
                            <th>Last Modified</th>
                            <th>Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var task in Model)
                            {
                                <tr>
                                    <td>@task.Id</td>
                                    <td>@task.Name</td>
                                    <td>@task.Description</td>
                                    <td>@task.Status</td>

                                    <td>
                                        @(task.DueDate?.ToString("yyyy-MM-dd HH:mm"))
                                    </td>

                                    <td>
                                        @(task.CreatedAt?.ToString("yyyy-MM-dd HH:mm"))
                                    </td>

                                    <td>
                                        @(task.LastModified?.ToString("yyyy-MM-dd HH:mm"))
                                    </td>

                                    <td>@task.ModifiedBy</td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">

                                            <a asp-action="Edit"
                                               asp-route-id="@task.Id"
                                               class="btn btn-sm btn-warning">
                                                Edit
                                            </a>

                                            <a asp-action="Details"
                                               asp-route-id="@task.Id"
                                               class="btn btn-sm btn-info">
                                                Details
                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@task.Id"
                                               class="btn btn-sm btn-danger">
                                                Delete
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center">
                                    No tasks found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>