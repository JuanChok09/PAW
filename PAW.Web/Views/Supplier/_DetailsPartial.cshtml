@model PAW.Models.DTO.SupplierDTO

<div class="card mt-3 mb-3 shadow-sm">

    <div class="card-header">
        <h5 class="mb-0">Supplier Details</h5>
    </div>

    <div class="card-body">

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Supplier ID:</div>
            <div class="col-md-9">@Model.SupplierId</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Supplier Name:</div>
            <div class="col-md-9">@Model.SupplierName</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Contact Name:</div>
            <div class="col-md-9">@Model.ContactName</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Contact Title:</div>
            <div class="col-md-9">@Model.ContactTitle</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Phone:</div>
            <div class="col-md-9">@Model.Phone</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Address:</div>
            <div class="col-md-9">@Model.Address</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">City:</div>
            <div class="col-md-9">@Model.City</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Country:</div>
            <div class="col-md-9">@Model.Country</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Last Modified:</div>
            <div class="col-md-9">@Model.LastModified</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Modified By:</div>
            <div class="col-md-9">@Model.ModifiedBy</div>
        </div>

    </div>

</div>