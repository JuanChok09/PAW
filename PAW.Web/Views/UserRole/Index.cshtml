@model IEnumerable<PAW.Models.DTO.UserRoleDTO>

@{
    ViewData["Title"] = "User Role Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>User Roles</h2>

        <button type="button"
                class="btn btn-primary"
                onclick="loadUserRoleCreate()">
            Add User Role
        </button>

    </div>

    <div id="userRoleDetails"></div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>ID</th>
                            <th>Role ID</th>
                            <th>User ID</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var userRole in Model)
                            {
                                <tr>

                                    <td>@userRole.Id</td>
                                    <td>@userRole.RoldId</td>
                                    <td>@userRole.UserId</td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="loadUserRoleEdit(@userRole.Id)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="loadUserRoleDetails(@userRole.Id)">
                                                Details
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteUserRole(@userRole.Id)">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center">

                                    No user roles found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        async function loadUserRoleDetails(id) {

            const response =
                await fetch('/UserRole/Details?id=' + id);

            const html =
                await response.text();

            document.getElementById('userRoleDetails')
                .innerHTML = html;
        }


        async function loadUserRoleEdit(id) {

            const response =
                await fetch('/UserRole/Edit?id=' + id);

            const html =
                await response.text();

            document.getElementById('userRoleDetails')
                .innerHTML = html;
        }


        async function saveUserRoleEdit() {

            const form =
                document.getElementById('editUserRoleForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/UserRole/Edit', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function loadUserRoleCreate() {

            const response =
                await fetch('/UserRole/Create');

            const html =
                await response.text();

            document.getElementById('userRoleDetails')
                .innerHTML = html;
        }


        async function saveUserRoleCreate() {

            const form =
                document.getElementById('createUserRoleForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/UserRole/Create', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function deleteUserRole(id) {

            const confirmed =
                confirm('Are you sure you want to delete this user role?');

            if (!confirmed) {
                return;
            }

            const response =
                await fetch('/UserRole/Delete?id=' + id, {
                    method: 'POST'
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }

    </script>
}