@model PAW.Models.DTO.RoleDTO

<div class="card mt-3 mb-3 shadow-sm">

    <div class="card-header">
        <h5 class="mb-0">Role Details</h5>
    </div>

    <div class="card-body">

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Role ID:</div>
            <div class="col-md-9">@Model.RoleId</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Role Name:</div>
            <div class="col-md-9">@Model.RoleName</div>
        </div>

    </div>

</div>