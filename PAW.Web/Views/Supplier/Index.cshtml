@model IEnumerable<PAW.Models.DTO.SupplierDTO>

@{
    ViewData["Title"] = "Supplier Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Suppliers</h2>

        <button type="button"
                class="btn btn-primary"
                onclick="loadSupplierCreate()">

            <i class="bi bi-plus-circle"></i>
            Add Supplier

        </button>

    </div>

    <div id="supplierDetails"></div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Supplier ID</th>
                            <th>Supplier Name</th>
                            <th>Contact Name</th>
                            <th>Contact Title</th>
                            <th>Phone</th>
                            <th>Address</th>
                            <th>City</th>
                            <th>Country</th>
                            <th>Last Modified</th>
                            <th>Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var supplier in Model)
                            {
                                <tr>

                                    <td>@supplier.SupplierId</td>
                                    <td>@supplier.SupplierName</td>
                                    <td>@supplier.ContactName</td>
                                    <td>@supplier.ContactTitle</td>
                                    <td>@supplier.Phone</td>
                                    <td>@supplier.Address</td>
                                    <td>@supplier.City</td>
                                    <td>@supplier.Country</td>

                                    <td>
                                        @supplier.LastModified?.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>@supplier.ModifiedBy</td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="loadSupplierEdit(@supplier.SupplierId)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="loadSupplierDetails(@supplier.SupplierId)">
                                                Details
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteSupplier(@supplier.SupplierId)">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="11"
                                    class="text-center">

                                    No suppliers found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        async function loadSupplierDetails(id) {

            const response =
                await fetch('/Supplier/Details?id=' + id);

            const html =
                await response.text();

            document.getElementById('supplierDetails')
                .innerHTML = html;
        }


        async function loadSupplierEdit(id) {

            const response =
                await fetch('/Supplier/Edit?id=' + id);

            const html =
                await response.text();

            document.getElementById('supplierDetails')
                .innerHTML = html;
        }


        async function saveSupplierEdit() {

            const form =
                document.getElementById('editSupplierForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/Supplier/Edit', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function loadSupplierCreate() {

            const response =
                await fetch('/Supplier/Create');

            const html =
                await response.text();

            document.getElementById('supplierDetails')
                .innerHTML = html;
        }


        async function saveSupplierCreate() {

            const form =
                document.getElementById('createSupplierForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/Supplier/Create', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function deleteSupplier(id) {

            const confirmed =
                confirm('Are you sure you want to delete this supplier?');

            if (!confirmed) {
                return;
            }

            const response =
                await fetch('/Supplier/Delete?id=' + id, {
                    method: 'POST'
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }

    </script>
}