@model PAW.Models.DTO.UserRoleDTO

<form id="editUserRoleForm">

    <input type="hidden" asp-for="Id" />

    <div class="card mt-3 mb-3 shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Edit User Role</h5>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label asp-for="RoldId" class="form-label"></label>
                <input asp-for="RoldId" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="UserId" class="form-label"></label>
                <input asp-for="UserId" class="form-control" />
            </div>

            <button type="button"
                    class="btn btn-success"
                    onclick="saveUserRoleEdit()">
                Save
            </button>

        </div>

    </div>

</form>