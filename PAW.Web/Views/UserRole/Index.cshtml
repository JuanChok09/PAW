@model IEnumerable<PAW.Models.DTO.UserRoleDTO>

@{
    ViewData["Title"] = "User Role Page";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>User Roles</h2>

        <button type="button"
                class="btn btn-primary"
                onclick="loadUserRoleCreate()">

            Add User Role

        </button>

    </div>

    <div id="userRoleDetails"></div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>ID</th>
                            <th>Role ID</th>
                            <th>User ID</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var userRole in Model)
                            {
                                <tr>

                                    <td>@userRole.Id</td>
                                    <td>@userRole.RoldId</td>
                                    <td>@userRole.UserId</td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="loadUserRoleEdit(@userRole.Id)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="loadUserRoleDetails(@userRole.Id)">
                                                Details
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteUserRole(@userRole.Id)">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center">

                                    No user roles found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    @if (totalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="UserRole"
                       asp-action="Index"
                       asp-route-page="1">
                        First
                    </a>

                </li>

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="UserRole"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)">
                        Previous
                    </a>

                </li>


                @if (currentPage > 2)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-controller="UserRole"
                           asp-action="Index"
                           asp-route-page="1">
                            1
                        </a>

                    </li>

                    @if (currentPage > 3)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }


                @for (int i = Math.Max(1, currentPage - 1);
                      i <= Math.Min(totalPages, currentPage + 1);
                      i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">

                        <a class="page-link"
                           asp-controller="UserRole"
                           asp-action="Index"
                           asp-route-page="@i">
                            @i
                        </a>

                    </li>
                }


                @if (currentPage < totalPages - 1)
                {
                    @if (currentPage < totalPages - 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    <li class="page-item">

                        <a class="page-link"
                           asp-controller="UserRole"
                           asp-action="Index"
                           asp-route-page="@totalPages">
                            @totalPages
                        </a>

                    </li>
                }


                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="UserRole"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)">
                        Next
                    </a>

                </li>


                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="UserRole"
                       asp-action="Index"
                       asp-route-page="@totalPages">
                        Last
                    </a>

                </li>

            </ul>

        </nav>
    }

</div>


@section Scripts {

    <script>

        async function loadUserRoleDetails(id) {

            const response =
                await fetch('/UserRole/Details?id=' + id);

            const html =
                await response.text();

            document.getElementById('userRoleDetails')
                .innerHTML = html;
        }


        async function loadUserRoleEdit(id) {

            const response =
                await fetch('/UserRole/Edit?id=' + id);

            const html =
                await response.text();

            document.getElementById('userRoleDetails')
                .innerHTML = html;
        }


        async function saveUserRoleEdit() {

            const form =
                document.getElementById('editUserRoleForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/UserRole/Edit', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function loadUserRoleCreate() {

            const response =
                await fetch('/UserRole/Create');

            const html =
                await response.text();

            document.getElementById('userRoleDetails')
                .innerHTML = html;
        }


        async function saveUserRoleCreate() {

            const form =
                document.getElementById('createUserRoleForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/UserRole/Create', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function deleteUserRole(id) {

            const confirmed =
                confirm('Are you sure you want to delete this user role?');

            if (!confirmed) {
                return;
            }

            const response =
                await fetch('/UserRole/Delete?id=' + id, {
                    method: 'POST'
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }

    </script>
}