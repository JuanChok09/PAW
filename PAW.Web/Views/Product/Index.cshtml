@model IEnumerable<PAW.Models.DTO.ProductDTO>

@{
    ViewData["Title"] = "Product Page";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Products</h2>

        <button type="button"
                class="btn btn-primary"
                onclick="loadCreate()">
            <i class="bi bi-plus-circle"></i>
            Add Product
        </button>
    </div>

    <div id="productDetails"></div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Product ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Rating</th>
                            <th>Comments</th>
                            <th>Created By</th>
                            <th>Created Date</th>
                            <th>Modified By</th>
                            <th>Modified Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var product in Model)
                            {
                                <tr>

                                    <td>@product.ProductId</td>

                                    <td>
                                        <strong>@product.Name</strong>
                                    </td>

                                    <td>@product.Description</td>

                                    <td>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= product.Rating)
                                            {
                                                <span class="text-warning">★</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">☆</span>
                                            }
                                        }
                                    </td>

                                    <td>@product.Comments</td>

                                    <td>@product.CreatedBy</td>

                                    <td>
                                        @product.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>@product.ModifiedBy</td>

                                    <td>
                                        @product.ModifiedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="loadEdit(@product.ProductId)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="loadDetails(@product.ProductId)">
                                                Details
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteProduct(@product.ProductId)">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center">
                                    No products found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>


    @if (totalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="Product"
                       asp-action="Index"
                       asp-route-page="1">
                        First
                    </a>
                </li>


                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-controller="Product"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)">
                        Previous
                    </a>
                </li>


                @if (currentPage > 2)
                {
                    <li class="page-item">
                        <a class="page-link"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-page="1">
                            1
                        </a>
                    </li>

                    @if (currentPage > 3)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }


                @for (int i = Math.Max(1, currentPage - 1);
                      i <= Math.Min(totalPages, currentPage + 1);
                      i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">

                        <a class="page-link"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-page="@i">

                            @i

                        </a>

                    </li>
                }


                @if (currentPage < totalPages - 1)
                {
                    @if (currentPage < totalPages - 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    <li class="page-item">

                        <a class="page-link"
                           asp-controller="Product"
                           asp-action="Index"
                           asp-route-page="@totalPages">

                            @totalPages

                        </a>

                    </li>
                }


                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Product"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)">

                        Next

                    </a>

                </li>


                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Product"
                       asp-action="Index"
                       asp-route-page="@totalPages">

                        Last

                    </a>

                </li>

            </ul>

        </nav>
    }

</div>


@section Scripts {

    <script>

        async function loadDetails(id) {

            const response = await fetch('/Product/Details?id=' + id);

            const html = await response.text();

            document.getElementById('productDetails').innerHTML = html;
        }


        async function loadEdit(id) {

            const response = await fetch('/Product/Edit?id=' + id);

            const html = await response.text();

            document.getElementById('productDetails').innerHTML = html;
        }


        async function saveProductEdit() {

            const form = document.getElementById('editProductForm');

            const formData = new FormData(form);

            const response = await fetch('/Product/Edit', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function loadCreate() {

            const response = await fetch('/Product/Create');

            const html = await response.text();

            document.getElementById('productDetails').innerHTML = html;
        }


        async function saveProductCreate() {

            const form = document.getElementById('createProductForm');

            const formData = new FormData(form);

            const response = await fetch('/Product/Create', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function deleteProduct(id) {

            const confirmed =
                confirm('Are you sure you want to delete this product?');

            if (!confirmed) {
                return;
            }

            const response =
                await fetch('/Product/Delete?id=' + id, {
                    method: 'POST'
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }

    </script>
}