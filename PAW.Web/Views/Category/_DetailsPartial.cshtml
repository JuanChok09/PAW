@model PAW.Models.DTO.CategoryDTO

<div class="card mt-3 mb-3 shadow-sm">

    <div class="card-header">
        <h5 class="mb-0">Category Details</h5>
    </div>

    <div class="card-body">

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Category ID:</div>
            <div class="col-md-9">@Model.CategoryId</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Name:</div>
            <div class="col-md-9">@Model.CategoryName</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Description:</div>
            <div class="col-md-9">@Model.Description</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Modified By:</div>
            <div class="col-md-9">@Model.ModifiedBy</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Last Modified:</div>
            <div class="col-md-9">@Model.LastModified</div>
        </div>

    </div>

</div>