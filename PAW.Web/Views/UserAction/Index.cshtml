@model IEnumerable<PAW.Models.DTO.UserActionDTO>

@{
    ViewData["Title"] = "User Action Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>User Actions</h2>

        <button type="button"
                class="btn btn-primary"
                onclick="loadUserActionCreate()">

            Add User Action

        </button>

    </div>

    <div id="userActionDetails"></div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var userAction in Model)
                            {
                                <tr>

                                    <td>@userAction.Id</td>
                                    <td>@userAction.Name</td>
                                    <td>@userAction.Description</td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="loadUserActionEdit(@userAction.Id)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="loadUserActionDetails(@userAction.Id)">
                                                Details
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteUserAction(@userAction.Id)">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center">

                                    No user actions found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        async function loadUserActionDetails(id) {

            const response =
                await fetch('/UserAction/Details?id=' + id);

            const html =
                await response.text();

            document.getElementById('userActionDetails')
                .innerHTML = html;
        }


        async function loadUserActionEdit(id) {

            const response =
                await fetch('/UserAction/Edit?id=' + id);

            const html =
                await response.text();

            document.getElementById('userActionDetails')
                .innerHTML = html;
        }


        async function saveUserActionEdit() {

            const form =
                document.getElementById('editUserActionForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/UserAction/Edit', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function loadUserActionCreate() {

            const response =
                await fetch('/UserAction/Create');

            const html =
                await response.text();

            document.getElementById('userActionDetails')
                .innerHTML = html;
        }


        async function saveUserActionCreate() {

            const form =
                document.getElementById('createUserActionForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/UserAction/Create', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function deleteUserAction(id) {

            const confirmed =
                confirm('Are you sure you want to delete this user action?');

            if (!confirmed) {
                return;
            }

            const response =
                await fetch('/UserAction/Delete?id=' + id, {
                    method: 'POST'
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }

    </script>
}