@model IEnumerable<PAW.Models.DTO.ComponentDTO>

@{
    ViewData["Title"] = "Components";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Components</h2>

        <button type="button"
                class="btn btn-primary"
                onclick="loadComponentCreate()">

            <i class="bi bi-plus-circle"></i>
            Add Component

        </button>

    </div>

    <div id="componentDetails"></div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>Content</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var component in Model)
                            {
                                <tr>

                                    <td>@component.Id</td>

                                    <td>
                                        <strong>@component.Name</strong>
                                    </td>

                                    <td>@component.Content</td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="loadComponentEdit(@component.Id)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="loadComponentDetails(@component.Id)">
                                                Details
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteComponent(@component.Id)">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="4"
                                    class="text-center">

                                    No components found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        async function loadComponentDetails(id) {

            const response =
                await fetch('/Component/Details?id=' + id);

            const html =
                await response.text();

            document.getElementById('componentDetails')
                .innerHTML = html;
        }


        async function loadComponentEdit(id) {

            const response =
                await fetch('/Component/Edit?id=' + id);

            const html =
                await response.text();

            document.getElementById('componentDetails')
                .innerHTML = html;
        }


        async function saveComponentEdit() {

            const form =
                document.getElementById('editComponentForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/Component/Edit', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function loadComponentCreate() {

            const response =
                await fetch('/Component/Create');

            const html =
                await response.text();

            document.getElementById('componentDetails')
                .innerHTML = html;
        }


        async function saveComponentCreate() {

            const form =
                document.getElementById('createComponentForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/Component/Create', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function deleteComponent(id) {

            const confirmed =
                confirm('Are you sure you want to delete this component?');

            if (!confirmed) {
                return;
            }

            const response =
                await fetch('/Component/Delete?id=' + id, {
                    method: 'POST'
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }

    </script>
}