@model IEnumerable<PAW.Models.DTO.InventoryDTO>

@{
    ViewData["Title"] = "Inventory Page";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Inventory</h2>

        <button type="button"
                class="btn btn-primary"
                onclick="loadInventoryCreate()">

            <i class="bi bi-plus-circle"></i>
            Add Inventory

        </button>

    </div>

    <div id="inventoryDetails"></div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Inventory ID</th>
                            <th>Unit Price</th>
                            <th>Units In Stock</th>
                            <th>Product ID</th>
                            <th>Date Added</th>
                            <th>Last Updated</th>
                            <th>Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var inventory in Model)
                            {
                                <tr>

                                    <td>@inventory.InventoryId</td>

                                    <td>@inventory.UnitPrice</td>

                                    <td>@inventory.UnitsInStock</td>

                                    <td>@inventory.ProductId</td>

                                    <td>
                                        @inventory.DateAdded?.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>
                                        @inventory.LastUpdated?.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>@inventory.ModifiedBy</td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="loadInventoryEdit(@inventory.InventoryId)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="loadInventoryDetails(@inventory.InventoryId)">
                                                Details
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteInventory(@inventory.InventoryId)">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="8"
                                    class="text-center">

                                    No inventory records found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    @if (totalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Inventory"
                       asp-action="Index"
                       asp-route-page="1">

                        First

                    </a>

                </li>


                <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Inventory"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)">

                        Previous

                    </a>

                </li>


                @if (currentPage > 2)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-controller="Inventory"
                           asp-action="Index"
                           asp-route-page="1">

                            1

                        </a>

                    </li>

                    @if (currentPage > 3)
                    {
                        <li class="page-item disabled">

                            <span class="page-link">
                                ...
                            </span>

                        </li>
                    }
                }


                @for (int i = Math.Max(1, currentPage - 1);
                      i <= Math.Min(totalPages, currentPage + 1);
                      i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">

                        <a class="page-link"
                           asp-controller="Inventory"
                           asp-action="Index"
                           asp-route-page="@i">

                            @i

                        </a>

                    </li>
                }


                @if (currentPage < totalPages - 1)
                {
                    @if (currentPage < totalPages - 2)
                    {
                        <li class="page-item disabled">

                            <span class="page-link">
                                ...
                            </span>

                        </li>
                    }

                    <li class="page-item">

                        <a class="page-link"
                           asp-controller="Inventory"
                           asp-action="Index"
                           asp-route-page="@totalPages">

                            @totalPages

                        </a>

                    </li>
                }


                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Inventory"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)">

                        Next

                    </a>

                </li>


                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Inventory"
                       asp-action="Index"
                       asp-route-page="@totalPages">

                        Last

                    </a>

                </li>

            </ul>

        </nav>
    }

</div>


@section Scripts {

    <script>

        async function loadInventoryDetails(id) {

            const response =
                await fetch('/Inventory/Details?id=' + id);

            const html =
                await response.text();

            document.getElementById('inventoryDetails')
                .innerHTML = html;
        }


        async function loadInventoryEdit(id) {

            const response =
                await fetch('/Inventory/Edit?id=' + id);

            const html =
                await response.text();

            document.getElementById('inventoryDetails')
                .innerHTML = html;
        }


        async function saveInventoryEdit() {

            const form =
                document.getElementById('editInventoryForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/Inventory/Edit', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function loadInventoryCreate() {

            const response =
                await fetch('/Inventory/Create');

            const html =
                await response.text();

            document.getElementById('inventoryDetails')
                .innerHTML = html;
        }


        async function saveInventoryCreate() {

            const form =
                document.getElementById('createInventoryForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/Inventory/Create', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function deleteInventory(id) {

            const confirmed =
                confirm('Are you sure you want to delete this inventory record?');

            if (!confirmed) {
                return;
            }

            const response =
                await fetch('/Inventory/Delete?id=' + id, {
                    method: 'POST'
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }

    </script>
}