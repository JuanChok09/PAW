@model PAW.Models.DTO.UserRoleDTO

<div class="card mt-3 mb-3 shadow-sm">

    <div class="card-header">
        <h5 class="mb-0">User Role Details</h5>
    </div>

    <div class="card-body">

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">ID:</div>
            <div class="col-md-9">@Model.Id</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">Role ID:</div>
            <div class="col-md-9">@Model.RoldId</div>
        </div>

        <div class="row mb-2">
            <div class="col-md-3 fw-bold">User ID:</div>
            <div class="col-md-9">@Model.UserId</div>
        </div>

    </div>

</div>