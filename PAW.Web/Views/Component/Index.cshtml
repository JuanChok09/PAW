@model IEnumerable<PAW.Models.DTO.ComponentDTO>

@{
    ViewData["Title"] = "Components";
}

<h1>Components</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Component</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Content</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var component in Model)
        {
            <tr>
                <td>@component.Id</td>
                <td>@component.Name</td>
                <td>@component.Content</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@component.Id"
                       class="btn btn-warning">Edit</a>

                    <a asp-action="Details"
                       asp-route-id="@component.Id"
                       class="btn btn-info">Details</a>

                    <a asp-action="Delete"
                       asp-route-id="@component.Id"
                       class="btn btn-danger">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>