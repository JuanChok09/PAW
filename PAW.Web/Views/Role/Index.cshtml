@model IEnumerable<PAW.Models.DTO.RoleDTO>

@{
    ViewData["Title"] = "Role Page";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Roles</h2>

        <button type="button"
                class="btn btn-primary"
                onclick="loadRoleCreate()">

            <i class="bi bi-plus-circle"></i>
            Add Role

        </button>

    </div>

    <div id="roleDetails"></div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>Role ID</th>
                            <th>Role Name</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var role in Model)
                            {
                                <tr>

                                    <td>@role.RoleId</td>

                                    <td>
                                        <strong>@role.RoleName</strong>
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="loadRoleEdit(@role.RoleId)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="loadRoleDetails(@role.RoleId)">
                                                Details
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteRole(@role.RoleId)">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="3"
                                    class="text-center">

                                    No roles found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    @if (totalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Role"
                       asp-action="Index"
                       asp-route-page="1">

                        First

                    </a>

                </li>


                <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Role"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)">

                        Previous

                    </a>

                </li>


                @if (currentPage > 2)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-controller="Role"
                           asp-action="Index"
                           asp-route-page="1">

                            1

                        </a>

                    </li>

                    @if (currentPage > 3)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }


                @for (int i = Math.Max(1, currentPage - 1);
                      i <= Math.Min(totalPages, currentPage + 1);
                      i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">

                        <a class="page-link"
                           asp-controller="Role"
                           asp-action="Index"
                           asp-route-page="@i">

                            @i

                        </a>

                    </li>
                }


                @if (currentPage < totalPages - 1)
                {
                    @if (currentPage < totalPages - 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    <li class="page-item">

                        <a class="page-link"
                           asp-controller="Role"
                           asp-action="Index"
                           asp-route-page="@totalPages">

                            @totalPages

                        </a>

                    </li>
                }


                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Role"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)">

                        Next

                    </a>

                </li>


                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="Role"
                       asp-action="Index"
                       asp-route-page="@totalPages">

                        Last

                    </a>

                </li>

            </ul>

        </nav>
    }

</div>


@section Scripts {

    <script>

        async function loadRoleDetails(id) {

            const response =
                await fetch('/Role/Details?id=' + id);

            const html =
                await response.text();

            document.getElementById('roleDetails')
                .innerHTML = html;
        }


        async function loadRoleEdit(id) {

            const response =
                await fetch('/Role/Edit?id=' + id);

            const html =
                await response.text();

            document.getElementById('roleDetails')
                .innerHTML = html;
        }


        async function saveRoleEdit() {

            const form =
                document.getElementById('editRoleForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/Role/Edit', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function loadRoleCreate() {

            const response =
                await fetch('/Role/Create');

            const html =
                await response.text();

            document.getElementById('roleDetails')
                .innerHTML = html;
        }


        async function saveRoleCreate() {

            const form =
                document.getElementById('createRoleForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/Role/Create', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function deleteRole(id) {

            const confirmed =
                confirm('Are you sure you want to delete this role?');

            if (!confirmed) {
                return;
            }

            const response =
                await fetch('/Role/Delete?id=' + id, {
                    method: 'POST'
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }

    </script>
}