@model IEnumerable<PAW.Models.DTO.ProductDTO>

@{
    ViewData["Title"] = "Product Page";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Products</h2>

        <button type="button"
                class="btn btn-primary"
                onclick="loadCreate()">
            <i class="bi bi-plus-circle"></i>
            Add Product
        </button>
    </div>

    <div id="productDetails"></div>

    <div class="card shadow-sm">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Product ID</th>
                            <th>Name</th>
                            <th>Description</th>
                            <th>Rating</th>
                            <th>Comments</th>
                            <th>Created By</th>
                            <th>Created Date</th>
                            <th>Modified By</th>
                            <th>Modified Date</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var product in Model)
                            {
                                <tr>

                                    <td>@product.ProductId</td>

                                    <td>
                                        <strong>@product.Name</strong>
                                    </td>

                                    <td>@product.Description</td>

                                    <td>
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= product.Rating)
                                            {
                                                <span class="text-warning">★</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">☆</span>
                                            }
                                        }
                                    </td>

                                    <td>@product.Comments</td>

                                    <td>@product.CreatedBy</td>

                                    <td>
                                        @product.CreatedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>@product.ModifiedBy</td>

                                    <td>
                                        @product.ModifiedDate.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <!-- Edit -->
                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="loadEdit(@product.ProductId)">
                                                Edit
                                            </button>

                                            <!-- Details -->
                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="loadDetails(@product.ProductId)">
                                                Details
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteProduct(@product.ProductId)">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="10" class="text-center">
                                    No products found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>

</div>
@section Scripts {

    <script>

        async function loadDetails(id) {

            const response = await fetch('/Product/Details?id=' + id);

            const html = await response.text();

            document.getElementById('productDetails').innerHTML = html;
        }


        async function loadEdit(id) {

            const response = await fetch('/Product/Edit?id=' + id);

            const html = await response.text();

            document.getElementById('productDetails').innerHTML = html;
        }


        async function saveProductEdit() {

            const form = document.getElementById('editProductForm');

            const formData = new FormData(form);

            const response = await fetch('/Product/Edit', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function loadCreate() {

            const response = await fetch('/Product/Create');

            const html = await response.text();

            document.getElementById('productDetails').innerHTML = html;
        }


        async function saveProductCreate() {

            const form = document.getElementById('createProductForm');

            const formData = new FormData(form);

            const response = await fetch('/Product/Create', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function deleteProduct(id) {

            const confirmed = confirm('Are you sure you want to delete this product?');

            if (!confirmed) {
                return;
            }

            const response = await fetch('/Product/Delete?id=' + id, {
                method: 'POST'
            });

            const result = await response.json();

            if (result.success) {
                location.reload();
            }
        }

    </script>
}