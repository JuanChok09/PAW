@model IEnumerable<PAW.Models.DTO.UserDTO>

@{
    ViewData["Title"] = "User Page";

    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Users</h2>

        <button type="button"
                class="btn btn-primary"
                onclick="loadUserCreate()">

            Add User

        </button>

    </div>

    <div id="userDetails"></div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>User ID</th>
                            <th>Username</th>
                            <th>Email</th>
                            <th>Created At</th>
                            <th>Is Active</th>
                            <th>Role ID</th>
                            <th>Last Modified</th>
                            <th>Modified By</th>
                            <th>Last Modified By</th>
                            <th class="text-center">Actions</th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model != null && Model.Any())
                        {
                            foreach (var user in Model)
                            {
                                <tr>

                                    <td>@user.UserId</td>
                                    <td>@user.Username</td>
                                    <td>@user.Email</td>

                                    <td>
                                        @user.CreatedAt?.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>@user.IsActive</td>

                                    <td>@user.RoleId</td>

                                    <td>
                                        @user.LastModified?.ToString("yyyy-MM-dd HH:mm")
                                    </td>

                                    <td>@user.ModifiedBy</td>
                                    <td>@user.LastModifiedBy</td>

                                    <td class="text-center">

                                        <div class="btn-group" role="group">

                                            <button type="button"
                                                    class="btn btn-sm btn-warning"
                                                    onclick="loadUserEdit(@user.UserId)">
                                                Edit
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-info"
                                                    onclick="loadUserDetails(@user.UserId)">
                                                Details
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-danger"
                                                    onclick="deleteUser(@user.UserId)">
                                                Delete
                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="10"
                                    class="text-center">

                                    No users found.

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    @if (totalPages > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="User"
                       asp-action="Index"
                       asp-route-page="1">
                        First
                    </a>

                </li>


                <li class="page-item @(currentPage == 1 ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="User"
                       asp-action="Index"
                       asp-route-page="@(currentPage - 1)">
                        Previous
                    </a>

                </li>


                @if (currentPage > 2)
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-controller="User"
                           asp-action="Index"
                           asp-route-page="1">
                            1
                        </a>

                    </li>

                    @if (currentPage > 3)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }
                }


                @for (int i = Math.Max(1, currentPage - 1);
                      i <= Math.Min(totalPages, currentPage + 1);
                      i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">

                        <a class="page-link"
                           asp-controller="User"
                           asp-action="Index"
                           asp-route-page="@i">
                            @i
                        </a>

                    </li>
                }


                @if (currentPage < totalPages - 1)
                {
                    @if (currentPage < totalPages - 2)
                    {
                        <li class="page-item disabled">
                            <span class="page-link">...</span>
                        </li>
                    }

                    <li class="page-item">

                        <a class="page-link"
                           asp-controller="User"
                           asp-action="Index"
                           asp-route-page="@totalPages">
                            @totalPages
                        </a>

                    </li>
                }


                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="User"
                       asp-action="Index"
                       asp-route-page="@(currentPage + 1)">
                        Next
                    </a>

                </li>


                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">

                    <a class="page-link"
                       asp-controller="User"
                       asp-action="Index"
                       asp-route-page="@totalPages">
                        Last
                    </a>

                </li>

            </ul>

        </nav>
    }

</div>


@section Scripts {

    <script>

        async function loadUserDetails(id) {

            const response =
                await fetch('/User/Details?id=' + id);

            const html =
                await response.text();

            document.getElementById('userDetails')
                .innerHTML = html;
        }


        async function loadUserEdit(id) {

            const response =
                await fetch('/User/Edit?id=' + id);

            const html =
                await response.text();

            document.getElementById('userDetails')
                .innerHTML = html;
        }


        async function saveUserEdit() {

            const form =
                document.getElementById('editUserForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/User/Edit', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function loadUserCreate() {

            const response =
                await fetch('/User/Create');

            const html =
                await response.text();

            document.getElementById('userDetails')
                .innerHTML = html;
        }


        async function saveUserCreate() {

            const form =
                document.getElementById('createUserForm');

            const formData =
                new FormData(form);

            const response =
                await fetch('/User/Create', {
                    method: 'POST',
                    body: formData
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }


        async function deleteUser(id) {

            const confirmed =
                confirm('Are you sure you want to delete this user?');

            if (!confirmed) {
                return;
            }

            const response =
                await fetch('/User/Delete?id=' + id, {
                    method: 'POST'
                });

            const result =
                await response.json();

            if (result.success) {
                location.reload();
            }
        }

    </script>
}