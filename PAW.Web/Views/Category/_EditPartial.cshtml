@model PAW.Models.DTO.CategoryDTO

<form id="editCategoryForm">

    <input type="hidden" asp-for="CategoryId" />

    <div class="card mt-3 mb-3 shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Edit Category</h5>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label asp-for="CategoryName" class="form-label"></label>
                <input asp-for="CategoryName" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <input asp-for="Description" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ModifiedBy" class="form-label"></label>
                <input asp-for="ModifiedBy" class="form-control" />
            </div>

            <button type="button"
                    class="btn btn-success"
                    onclick="saveCategoryEdit()">
                Save
            </button>

        </div>

    </div>

</form>