@model PAW.Models.DTO.InventoryDTO

<form id="editInventoryForm">

    <input type="hidden" asp-for="InventoryId" />

    <div class="card mt-3 mb-3 shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">Edit Inventory</h5>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <label asp-for="UnitPrice" class="form-label"></label>
                <input asp-for="UnitPrice" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="UnitsInStock" class="form-label"></label>
                <input asp-for="UnitsInStock" class="form-control" />
            </div>

            <div class="mb-3">
                <label asp-for="ProductId" class="form-label"></label>
                <input asp-for="ProductId" class="form-control" />
            </div>

            <input type="hidden" asp-for="DateAdded" />

            <div class="mb-3">
                <label asp-for="ModifiedBy" class="form-label"></label>
                <input asp-for="ModifiedBy" class="form-control" />
            </div>

            <button type="button"
                    class="btn btn-success"
                    onclick="saveInventoryEdit()">
                Save
            </button>

        </div>

    </div>

</form>